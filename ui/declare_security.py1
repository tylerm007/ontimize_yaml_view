from security.system.authorization import Grant, Security, Security, DefaultRolePermission, GlobalFilter
class Roles():
    backoffice = "backoffice"
    ClientReportDetailer = "ClientReportDetailer"
    masterPlanner = "masterPlanner"
    clientUser = "clientUser"
    recaster = "recaster"
    readonly = "readonly"
    recastUploader = "recastUploader"
    winter17 = "winter17"
    fullaccess = "fullaccess"
# Roles
DefaultRolePermission(to_role=Roles.backoffice, can_read=True, can_insert=False, can_update=False, can_delete=False)
DefaultRolePermission(to_role=Roles.ClientReportDetailer, can_read=True, can_insert=False, can_update=False, can_delete=False)
