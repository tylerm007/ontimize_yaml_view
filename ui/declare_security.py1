DefaultRolePermission(to_role=Roles.readonly, can_read=True, can_insert=False, can_update=False, can_delete=False)
DefaultRolePermission(to_role=Roles.recastUploader, can_read=False, can_insert=False, can_update=False, can_delete=False)
DefaultRolePermission(to_role=Roles.winter17, can_read=False, can_insert=False, can_update=False, can_delete=False)
DefaultRolePermission(to_role=Roles.fullaccess, can_read=True, can_insert=True, can_update=True, can_delete=True)
