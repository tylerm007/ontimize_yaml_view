# Constraints
    Rule.constraint(validate=models.TargetArea,calling=fn_targetarea_validation_validation_72,error_msg='The area code must be a single digit 0-9')
    Rule.constraint(validate=models.RecastSet,calling=fn_recastset_validation_validation_42,error_msg='Please enter a valid four-digit year.')
    Rule.constraint(validate=models.RecastSet,calling=fn_recastset_validation_validation_43,error_msg='Please enter a number between (0-100).')
    Rule.constraint(validate=models.AccountUpload,calling=fn_accountupload_validation_validation_1,error_msg='The data you are attempting to load does not have a valid unique permission id.  You must be provided a valid, active, unused key prior to upload.  Please contact support.')
    Rule.constraint(validate=models.Entity,calling=fn_entity_validation_validation_29,error_msg='You must enter a number between 0 and 100.')
    Rule.constraint(validate=models.TargetSubArea,calling=fn_targetsubarea_validation_validation_77,error_msg='subAreaCode must be a two-digit number 0-99.')
    Rule.constraint(validate=models.TargetFirstLevel,calling=fn_targetfirstlevel_validation_validation_73,error_msg='The account first code must be a number 0-99')
    Rule.constraint(validate=models.TargetFirstLevel,calling=fn_targetfirstlevel_validation_validation_74,error_msg='You can only target Revenue or Expense accounts.  Enter 4 for Revenue and 5 for Expense.')
    Rule.constraint(validate=models.TargetSecondLevel,calling=fn_targetsecondlevel_validation_validation_75,error_msg='The account second code must be a number 0-99.')
    Rule.constraint(validate=models.TargetSecondLevel,calling=fn_targetsecondlevel_validation_validation_76,error_msg='You can only target Revenue or Expense accounts.  Enter 4 for Revenue and 5 for Expense.')
    Rule.constraint(validate=models.EliminationFirstLevel,calling=fn_eliminationfirstlevel_validation_validation_27,error_msg='This Recast Set has been locked.  You are not allowed to add or modify elimination entries once a set is locked.  Contact Support.')
    Rule.constraint(validate=models.EliminationSecondLevel,calling=fn_eliminationsecondlevel_validation_validation_28,error_msg='This Recast Set is locked.  You are not allowed to add or modify elimination entries once a set has been locked.  Contact Support.')
    Rule.constraint(validate=models.AnalysisTemplate,calling=fn_analysistemplate_validation_validation_5,error_msg='If not left blank (null), the year must be between 2000 and 2100.')
    Rule.constraint(validate=models.ScenarioYear,calling=fn_scenarioyear_validation_validation_49,error_msg='Please enter a valid four digit year (2000-2100).')
    Rule.constraint(validate=models.ScenarioYear,calling=fn_scenarioyear_validation_validation_50,error_msg='This must be a number between zero and 99')
    Rule.constraint(validate=models.ScenarioYear,calling=fn_scenarioyear_validation_validation_51,error_msg='The entity that you have selected is not for the client your have entered.')
    Rule.constraint(validate=models.Actor,calling=fn_actor_validation_validation_2,error_msg='The year must be between 2000 and 2100')
    Rule.constraint(validate=models.Client,calling=fn_client_validation_validation_24,error_msg='The client Id must be a four digit number.')
    Rule.constraint(validate=models.Impact,calling=fn_impact_validation_validation_31,error_msg='Your impact cannot start in the base year or before.  Choose a later year')
    Rule.constraint(validate=models.Impact,calling=fn_impact_validation_validation_30,error_msg='Select a year between 2000 and 2100.  Enter four digits.')
# Events
    Rule.row_event(on_class=models.SourceBenchmarkDatum,calling=fn_sourcebenchmarkdata_event_event_59)
    Rule.commit_row_event(on_class=models.ScenarioYear,calling=fn_scenarioyear_commitEvent_eventCommit_52)
    Rule.row_event(on_class=models.SourceDataFeedsForBenchmark,calling=fn_sourcedatafeedsforbenchmark_event_event_61)
