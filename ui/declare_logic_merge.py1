from logic_bank.logic_bank import Rule
# Rule Function Calling
    def fn_targetarea_validation_validation_7(row: model.TargetArea, old_row: model.TargetArea, logic_row:LogicRow):
           pass
    def fn_recastset_validation_validation_4(row: model.RecastSet, old_row: model.RecastSet, logic_row:LogicRow):
           pass
    def fn_recastset_validation_validation_4(row: model.RecastSet, old_row: model.RecastSet, logic_row:LogicRow):
           pass
    def fn_assembledfirstlevel_formula_formula_eliminationBalance(row: model.AssembledFirstLevel, old_row: model.AssembledFirstLevel, logic_row:LogicRow):
           pass
    def fn_leafjctnsecondlevel_formula_formula_balance(row: model.LeafJctnSecondLevel, old_row: model.LeafJctnSecondLevel, logic_row:LogicRow):
           pass
    def fn_valuesforreport_formula_formula_letterGrade(row: model.ValuesForReport, old_row: model.ValuesForReport, logic_row:LogicRow):
           pass
    def fn_recastset_formula_formula_recastSetCode(row: model.RecastSet, old_row: model.RecastSet, logic_row:LogicRow):
           pass
# Constraints
    Rule.constraint(validate=models.TargetArea,calling=fn_targetarea_validation_validation_72,error_msg='The area code must be a single digit 0-9')
    Rule.constraint(validate=models.RecastSet,calling=fn_recastset_validation_validation_42,error_msg='Please enter a valid four-digit year.')
    Rule.constraint(validate=models.RecastSet,calling=fn_recastset_validation_validation_43,error_msg='Please enter a number between (0-100).')
# Events
# Derivations
    Rule.sum(derive=models.AssembledFirstLevel.eliminationBalanceList,as_sum_of=models.EliminationFirstLevel.amount)
    Rule.sum(derive=models.AssembledFirstLevel.alteredBalChildren,as_sum_of=models.AssembledSecondLevel.alteredBalance,where=lambda row: row.balance is not None)
    Rule.formula(derive=models.AssembledFirstLevel.eliminationBalance,calling=fn_assembledfirstlevel_formula_formula_eliminationBalance)
    Rule.sum(derive=models.AssembledFirstLevel.combinedBalChildren,as_sum_of=models.AssembledSecondLevel.combinedBalance,where=lambda row: row.balance is not None)
    Rule.sum(derive=models.AssembledFirstLevel.eliminateBalChildren,as_sum_of=models.AssembledSecondLevel.eliminationBalance,where=lambda row: row.balance is not None)
    Rule.sum(derive=models.AssembledFirstLevel.combinedBalanceList,as_sum_of=models.LeafJctnFirstLevel.balance)
    Rule.formula(derive=models.AssembledFirstLevel.alteredBalance,as_expression=lambda row:  (row.leaf)  if  row.alteredBalance  else  row.alteredBalChildren)
    Rule.formula(derive=models.AssembledFirstLevel.balance,as_expression=lambda row:  row.combinedBalance + row.eliminationBalance + row.alteredBalance)
    Rule.formula(derive=models.AssembledFirstLevel.locked,as_expression=lambda row:  row.recastSet.locked)
    Rule.formula(derive=models.AssembledFirstLevel.combinedBalance,as_expression=lambda row:  (row.leaf)  if  row.combinedBalanceList  else  row.combinedBalChildren)
    Rule.formula(derive=models.LeafJctnSecondLevel.balance,calling=fn_leafjctnsecondlevel_formula_formula_balance)
    Rule.formula(derive=models.LeafJctnSecondLevel.locked,as_expression=lambda row:  row.assembledSecondLevel.locked)
    Rule.formula(derive=models.ValuesForReport.letterGrade,calling=fn_valuesforreport_formula_formula_letterGrade)
    Rule.sum(derive=models.AssembledSubArea.elimBalSecond,as_sum_of=models.AssembledFirstLevel.eliminateBalChildren)
    Rule.sum(derive=models.AssembledSubArea.combinedBalFirst,as_sum_of=models.AssembledFirstLevel.combinedBalanceList)
    Rule.sum(derive=models.AssembledSubArea.altBalFirst,as_sum_of=models.AssembledFirstLevel.alteredBalance,where=lambda row: row.leaf == 1)
    Rule.sum(derive=models.AssembledSubArea.elimBalFirst,as_sum_of=models.AssembledFirstLevel.eliminationBalanceList)
    Rule.sum(derive=models.AssembledSubArea.combinedBalSecond,as_sum_of=models.AssembledFirstLevel.combinedBalChildren)
    Rule.sum(derive=models.AssembledSubArea.altBalSecond,as_sum_of=models.AssembledFirstLevel.alteredBalChildren)
    Rule.count(derive=models.RecastSet.scenarioMemberCount,as_count_of=models.RecastSetMembership)
    Rule.formula(derive=models.RecastSet.eliminationBalance,as_expression=lambda row:  row.elimBalAE - row.elimBalLQR)
    Rule.formula(derive=models.RecastSet.recastSetCode,calling=fn_recastset_formula_formula_recastSetCode)
    Rule.sum(derive=models.RecastSet.elimBalLQR,as_sum_of=models.AssembledArea.eliminationBalance,where=lambda row: row.areaCode != 1 and row.aeaCode != 5)
    Rule.sum(derive=models.RecastSet.elimBalAE,as_sum_of=models.AssembledArea.eliminationBalance,where=lambda row: row.areaCode == 1 or row.areaCode  == 5)
    Rule.formula(derive=models.AssembledFirstLevel.alteredBalance,as_expression=lambda row:  (row.leaf)  if  row.alteredBalance  else  row.alteredBalChildren)
    Rule.sum(derive=models.AssembledSubArea.elimBalSecond,as_sum_of=models.AssembledFirstLevel.eliminateBalChildren)
    Rule.sum(derive=models.AssembledSubArea.combinedBalFirst,as_sum_of=models.AssembledFirstLevel.combinedBalanceList)
    Rule.sum(derive=models.AssembledSubArea.elimBalFirst,as_sum_of=models.AssembledFirstLevel.eliminationBalanceList)
    Rule.sum(derive=models.AssembledFirstLevel.combinedBalChildren,as_sum_of=models.AssembledSecondLevel.combinedBalance,where=lambda row: row.balance is not None)
    Rule.formula(derive=models.AssembledFirstLevel.locked,as_expression=lambda row:  row.recastSet.locked)
    Rule.sum(derive=models.AssembledSubArea.combinedBalSecond,as_sum_of=models.AssembledFirstLevel.combinedBalChildren)
    Rule.sum(derive=models.RecastSet.elimBalLQR,as_sum_of=models.AssembledArea.eliminationBalance,where=lambda row: row.areaCode != 1 and row.aeaCode != 5)
    Rule.sum(derive=models.AssembledFirstLevel.eliminationBalanceList,as_sum_of=models.EliminationFirstLevel.amount)
    Rule.sum(derive=models.AssembledFirstLevel.alteredBalChildren,as_sum_of=models.AssembledSecondLevel.alteredBalance,where=lambda row: row.balance is not None)
    Rule.formula(derive=models.AssembledFirstLevel.eliminationBalance,calling=fn_assembledfirstlevel_formula_formula_eliminationBalance)
    Rule.sum(derive=models.AssembledFirstLevel.eliminateBalChildren,as_sum_of=models.AssembledSecondLevel.eliminationBalance,where=lambda row: row.balance is not None)
    Rule.sum(derive=models.AssembledFirstLevel.combinedBalanceList,as_sum_of=models.LeafJctnFirstLevel.balance)
    Rule.formula(derive=models.AssembledFirstLevel.balance,as_expression=lambda row:  row.combinedBalance + row.eliminationBalance + row.alteredBalance)
    Rule.formula(derive=models.AssembledFirstLevel.combinedBalance,as_expression=lambda row:  (row.leaf)  if  row.combinedBalanceList  else  row.combinedBalChildren)
    Rule.formula(derive=models.LeafJctnSecondLevel.balance,calling=fn_leafjctnsecondlevel_formula_formula_balance)
    Rule.formula(derive=models.LeafJctnSecondLevel.locked,as_expression=lambda row:  row.assembledSecondLevel.locked)
    Rule.sum(derive=models.AssembledSubArea.altBalFirst,as_sum_of=models.AssembledFirstLevel.alteredBalance,where=lambda row: row.leaf == 1)
    Rule.sum(derive=models.AssembledSubArea.altBalSecond,as_sum_of=models.AssembledFirstLevel.alteredBalChildren)
    Rule.count(derive=models.RecastSet.scenarioMemberCount,as_count_of=models.RecastSetMembership)
    Rule.formula(derive=models.RecastSet.eliminationBalance,as_expression=lambda row:  row.elimBalAE - row.elimBalLQR)
    Rule.formula(derive=models.RecastSet.recastSetCode,calling=fn_recastset_formula_formula_recastSetCode)
    Rule.sum(derive=models.RecastSet.elimBalAE,as_sum_of=models.AssembledArea.eliminationBalance,where=lambda row: row.areaCode == 1 or row.areaCode  == 5)
    Rule.formula(derive=models.ValuesForReport.letterGrade,calling=fn_valuesforreport_formula_formula_letterGrade)
