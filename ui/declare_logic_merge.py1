# Derivations
    Rule.sum(derive=models.AssembledFirstLevel.eliminationBalanceList,as_sum_of=models.EliminationFirstLevel.amount)
    Rule.sum(derive=models.AssembledFirstLevel.alteredBalChildren,as_sum_of=models.AssembledSecondLevel.alteredBalance,where=lambda row: row.balance is not None)
    Rule.formula(derive=models.AssembledFirstLevel.eliminationBalance,calling=fn_assembledfirstlevel_formula_formula_eliminationBalance)
    Rule.sum(derive=models.AssembledFirstLevel.combinedBalChildren,as_sum_of=models.AssembledSecondLevel.combinedBalance,where=lambda row: row.balance is not None)
    Rule.sum(derive=models.AssembledFirstLevel.eliminateBalChildren,as_sum_of=models.AssembledSecondLevel.eliminationBalance,where=lambda row: row.balance is not None)
    Rule.sum(derive=models.AssembledFirstLevel.combinedBalanceList,as_sum_of=models.LeafJctnFirstLevel.balance)
    Rule.formula(derive=models.AssembledFirstLevel.alteredBalance,as_expression=lambda row:  (row.leaf)  if  row.alteredBalance  else  row.alteredBalChildren)
    Rule.formula(derive=models.AssembledFirstLevel.balance,as_expression=lambda row:  row.combinedBalance + row.eliminationBalance + row.alteredBalance)
    Rule.formula(derive=models.AssembledFirstLevel.locked,as_expression=lambda row:  row.recastSet.locked)
    Rule.formula(derive=models.AssembledFirstLevel.combinedBalance,as_expression=lambda row:  (row.leaf)  if  row.combinedBalanceList  else  row.combinedBalChildren)
    Rule.formula(derive=models.LeafJctnSecondLevel.balance,calling=fn_leafjctnsecondlevel_formula_formula_balance)
    Rule.formula(derive=models.LeafJctnSecondLevel.locked,as_expression=lambda row:  row.assembledSecondLevel.locked)
    Rule.formula(derive=models.ValuesForReport.letterGrade,calling=fn_valuesforreport_formula_formula_letterGrade)
    Rule.sum(derive=models.AssembledSubArea.elimBalSecond,as_sum_of=models.AssembledFirstLevel.eliminateBalChildren)
    Rule.sum(derive=models.AssembledSubArea.combinedBalFirst,as_sum_of=models.AssembledFirstLevel.combinedBalanceList)
    Rule.sum(derive=models.AssembledSubArea.altBalFirst,as_sum_of=models.AssembledFirstLevel.alteredBalance,where=lambda row: row.leaf == 1)
    Rule.sum(derive=models.AssembledSubArea.elimBalFirst,as_sum_of=models.AssembledFirstLevel.eliminationBalanceList)
    Rule.sum(derive=models.AssembledSubArea.combinedBalSecond,as_sum_of=models.AssembledFirstLevel.combinedBalChildren)
    Rule.sum(derive=models.AssembledSubArea.altBalSecond,as_sum_of=models.AssembledFirstLevel.alteredBalChildren)
    Rule.count(derive=models.RecastSet.scenarioMemberCount,as_count_of=models.RecastSetMembership)
    Rule.formula(derive=models.RecastSet.eliminationBalance,as_expression=lambda row:  row.elimBalAE - row.elimBalLQR)
    Rule.formula(derive=models.RecastSet.recastSetCode,calling=fn_recastset_formula_formula_recastSetCode)
    Rule.sum(derive=models.RecastSet.elimBalLQR,as_sum_of=models.AssembledArea.eliminationBalance,where=lambda row: row.areaCode != 1 and row.aeaCode != 5)
    Rule.sum(derive=models.RecastSet.elimBalAE,as_sum_of=models.AssembledArea.eliminationBalance,where=lambda row: row.areaCode == 1 or row.areaCode  == 5)
    Rule.formula(derive=models.ClientReportDetail.letterGrade,calling=fn_clientreportdetail_formula_formula_letterGrade)
    Rule.sum(derive=models.ClientReportDetail.gradeCumulativePoints,as_sum_of=models.ValuesForReport.grade)
    Rule.formula(derive=models.LeafJctnFirstLevel.balance,calling=fn_leafjctnfirstlevel_formula_formula_balance)
    Rule.formula(derive=models.LeafJctnFirstLevel.locked,as_expression=lambda row:  row.assembledFirstLevel.locked)
    Rule.sum(derive=models.MappedSubArea.mappedBalance,as_sum_of=models.MappedFirstLevel.mappedBalance)
    Rule.sum(derive=models.MappedSubArea.accrualBalance,as_sum_of=models.MappedFirstLevel.accrualBalance)
    Rule.sum(derive=models.MappedSubArea.balance,as_sum_of=models.MappedFirstLevel.balance)
    Rule.sum(derive=models.MappedFirstLevel.mappedBalChildren,as_sum_of=models.MappedSecondLevel.mappedBalance,where=lambda row: row.balance is not None)
    Rule.formula(derive=models.MappedFirstLevel.accrualBalance,as_expression=lambda row:  (row.leaf)  if  row.accrualBalance  else  row.accrualBalChildren)
    Rule.sum(derive=models.MappedFirstLevel.accrualBalChildren,as_sum_of=models.MappedSecondLevel.accrualBalance,where=lambda row: row.balance is not None )
    Rule.formula(derive=models.MappedFirstLevel.mappedBalance,as_expression=lambda row:  (row.leaf)  if  row.mappedBalance  else  row.mappedBalChildren)
    Rule.formula(derive=models.MappedFirstLevel.balance,as_expression=lambda row:  (row.leaf)  if  row.balance  else  row.balanceChildren)
    Rule.sum(derive=models.MappedFirstLevel.balanceChildren,as_sum_of=models.MappedSecondLevel.balance,where=lambda row: row.balance is not None)
    Rule.sum(derive=models.MappedArea.mappedBalance,as_sum_of=models.MappedSubArea.mappedBalance)
    Rule.sum(derive=models.MappedArea.accrualBalance,as_sum_of=models.MappedSubArea.accrualBalance)
    Rule.sum(derive=models.MappedArea.balance,as_sum_of=models.MappedSubArea.balance)
    Rule.formula(derive=models.AssembledSecondLevel.balance,as_expression=lambda row:  row.combinedBalance + row.eliminationBalance + row.alteredBalance)
    Rule.formula(derive=models.AssembledSecondLevel.locked,as_expression=lambda row:  row.recastSet.locked)
    Rule.formula(derive=models.ScenarioYear.uid,calling=fn_scenarioyear_formula_formula_uid)
    Rule.formula(derive=models.ScenarioYear.scenarioCode,calling=fn_scenarioyear_formula_formula_scenarioCode)
    Rule.copy(derive=models.ScenarioYear.fiscalYearEnd,from_parent=models.Entity.fiscalYearEnd)
    Rule.sum(derive=models.AssembledArea.combinedBalFirst,as_sum_of=models.AssembledSubArea.combinedBalFirst)
    Rule.sum(derive=models.AssembledArea.elimBalFirst,as_sum_of=models.AssembledSubArea.elimBalFirst)
    Rule.sum(derive=models.AssembledArea.altBalSecond,as_sum_of=models.AssembledSubArea.altBalSecond)
    Rule.count(derive=models.Actor.actorCount,as_count_of=models.MotivatedActor)
    Rule.copy(derive=models.Impact.baseDataYear,from_parent=models.Actor.baseDataYear)
    Rule.count(derive=models.Motivation.motivationCount,as_count_of=models.MotivatedActor)
    Rule.sum(derive=models.AssembledSecondLevel.combinedBalance,as_sum_of=models.LeafJctnSecondLevel.balance)
    Rule.sum(derive=models.AssembledSecondLevel.eliminationBalance,as_sum_of=models.EliminationSecondLevel.amount)
    Rule.copy(derive=models.ScenarioYear.costMarket,from_parent=models.Entity.costMarket)
