    Rule.formula(derive=models.MappedFirstLevel.mappedBalance,as_expression=lambda row:  (row.leaf)  if  row.mappedBalance  else  row.mappedBalChildren)
    Rule.sum(derive=models.MappedFirstLevel.balanceChildren,as_sum_of=models.MappedSecondLevel.balance,where=lambda row: row.balance is not None)
    Rule.sum(derive=models.MappedFirstLevel.accrualBalChildren,as_sum_of=models.MappedSecondLevel.accrualBalance,where=lambda row: row.balance is not None )
    Rule.sum(derive=models.MappedSubArea.balance,as_sum_of=models.MappedFirstLevel.balance)
    Rule.sum(derive=models.MappedSubArea.accrualBalance,as_sum_of=models.MappedFirstLevel.accrualBalance)
    Rule.formula(derive=models.RecastSet.recastSetCode,calling=fn_recastset_formula_formula_recastSetCode)
    Rule.sum(derive=models.RecastSet.elimBalAE,as_sum_of=models.AssembledArea.eliminationBalance,where=lambda row: row.areaCode == 1 or row.areaCode  == 5)
    Rule.sum(derive=models.MappedSubArea.mappedBalance,as_sum_of=models.MappedFirstLevel.mappedBalance)
    Rule.count(derive=models.Motivation.motivationCount,as_count_of=models.MotivatedActor)
    Rule.count(derive=models.RecastSet.scenarioMemberCount,as_count_of=models.RecastSetMembership)
    Rule.formula(derive=models.RecastSet.eliminationBalance,as_expression=lambda row:  row.elimBalAE - row.elimBalLQR)
    Rule.sum(derive=models.RecastSet.elimBalLQR,as_sum_of=models.AssembledArea.eliminationBalance,where=lambda row: row.areaCode != 1 and row.aeaCode != 5)
    Rule.copy(derive=models.ScenarioYear.fiscalYearEnd,from_parent=models.Entity.fiscalYearEnd)
    Rule.copy(derive=models.ScenarioYear.cashAccrual,from_parent=models.Entity.cashAccrual)
    Rule.copy(derive=models.ScenarioYear.costMarket,from_parent=models.Entity.costMarket)
    Rule.formula(derive=models.ScenarioYear.scenarioCode,calling=fn_scenarioyear_formula_formula_scenarioCode)
    Rule.sum(derive=models.ScenarioYear.accrualBalance,as_sum_of=models.MappedArea.accrualBalance)
    Rule.formula(derive=models.ScenarioYear.uid,calling=fn_scenarioyear_formula_formula_uid)
    Rule.count(derive=models.ScenarioYear.countUploaded,as_count_of=models.AccountUpload)
    Rule.formula(derive=models.ValuesForReport.letterGrade,calling=fn_valuesforreport_formula_formula_letterGrade)
